# BioBox — Git attributes

# Normalize text across Windows and Raspberry Pi.
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.csv text eol=crlf

# Treat images, calibration files, and Office documents as binary.
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.bmp binary
*.tif binary
*.tiff binary
*.webp binary
*.npz binary
*.pdf binary
*.docx binary
*.xlsx binary

# Include browser source files in GitHub's language statistics.
/digital_twin/digital_twin_3d.html -linguist-generated
/digital_twin/digital_twin_3d.css -linguist-generated
/digital_twin/digital_twin_3d.js -linguist-generated
/plant_health/plant_health.html -linguist-generated
/plant_health/plant_health.css -linguist-generated
/plant_health/plant_health.js -linguist-generated
/charts/charts.html -linguist-generated
/charts/charts.css -linguist-generated
/charts/charts.js -linguist-generated

# Identify analysis outputs that are generated by the application.
/results/results.csv linguist-generated
/results/results.json linguist-generated
/results/masks/** linguist-generated
/results/overlays/** linguist-generated
/digital_twin/digital_twin.json linguist-generated
/plant_health/plant_health.json linguist-generated
/charts/charts.json linguist-generated
/charts/01_leaf_area.png linguist-generated
/charts/02_growth_rate.png linguist-generated
/charts/03_leaf_color.png linguist-generated
/charts/04_plant_health.png linguist-generated
/charts/05_health_subscores.png linguist-generated

# Keep the README and milestone documents out of the code breakdown.
*.md linguist-documentation

# Optional: uncomment the next line to include Markdown.
# *.md linguist-detectable -linguist-documentation
